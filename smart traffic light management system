// North-South traffic lights
const int NS_RED = 2;
const int NS_YELLOW = 3;
const int NS_GREEN = 4;

// East-West traffic lights
const int EW_RED = 5;
const int EW_YELLOW = 6;
const int EW_GREEN = 7;

// Ultrasonic sensors
const int TRIG_NS = 8;
const int ECHO_NS = 9;
const int TRIG_EW = 10;
const int ECHO_EW = 11;

// Pedestrian button and buzzer
const int PED_BUTTON = 12;
const int BUZZER = 13;

const int VEHICLE_DISTANCE = 20;

const unsigned long GREEN_NORMAL = 6000;
const unsigned long GREEN_BUSY = 10000;
const unsigned long YELLOW_TIME = 2000;
const unsigned long PED_TIME = 5000;

enum Phase {
  NS_GO,
  NS_CAUTION,
  EW_GO,
  EW_CAUTION,
  PEDESTRIAN
};

Phase phase = NS_GO;

unsigned long phaseStart = 0;
unsigned long phaseDuration = GREEN_NORMAL;

bool pedestrianRequested = false;
bool previousButton = HIGH;

unsigned long lastButtonChange = 0;

long distanceNS = 999;
long distanceEW = 999;

long readDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  unsigned long duration =
    pulseIn(echoPin, HIGH, 20000UL);

  if (duration == 0) {
    return 999;
  }

  return duration / 58;
}

void setLights(bool nr, bool ny, bool ng,
               bool er, bool ey, bool eg) {
  digitalWrite(NS_RED, nr);
  digitalWrite(NS_YELLOW, ny);
  digitalWrite(NS_GREEN, ng);

  digitalWrite(EW_RED, er);
  digitalWrite(EW_YELLOW, ey);
  digitalWrite(EW_GREEN, eg);
}

void enterPhase(Phase nextPhase) {
  phase = nextPhase;
  phaseStart = millis();

  switch (phase) {
    case NS_GO:
      phaseDuration =
        (distanceNS < VEHICLE_DISTANCE)
        ? GREEN_BUSY : GREEN_NORMAL;

      setLights(LOW, LOW, HIGH,
                HIGH, LOW, LOW);
      digitalWrite(BUZZER, LOW);
      break;

    case NS_CAUTION:
      phaseDuration = YELLOW_TIME;

      setLights(LOW, HIGH, LOW,
                HIGH, LOW, LOW);
      digitalWrite(BUZZER, LOW);
      break;

    case EW_GO:
      phaseDuration =
        (distanceEW < VEHICLE_DISTANCE)
        ? GREEN_BUSY : GREEN_NORMAL;

      setLights(HIGH, LOW, LOW,
                LOW, LOW, HIGH);
      digitalWrite(BUZZER, LOW);
      break;

    case EW_CAUTION:
      phaseDuration = YELLOW_TIME;

      setLights(HIGH, LOW, LOW,
                LOW, HIGH, LOW);
      digitalWrite(BUZZER, LOW);
      break;

    case PEDESTRIAN:
      phaseDuration = PED_TIME;

      setLights(HIGH, LOW, LOW,
                HIGH, LOW, LOW);

      digitalWrite(BUZZER, HIGH);
      pedestrianRequested = false;
      break;
  }

  Serial.print("Phase: ");
  Serial.println((int)phase);
}

void setup() {
  Serial.begin(9600);

  pinMode(NS_RED, OUTPUT);
  pinMode(NS_YELLOW, OUTPUT);
  pinMode(NS_GREEN, OUTPUT);

  pinMode(EW_RED, OUTPUT);
  pinMode(EW_YELLOW, OUTPUT);
  pinMode(EW_GREEN, OUTPUT);

  pinMode(TRIG_NS, OUTPUT);
  pinMode(ECHO_NS, INPUT);

  pinMode(TRIG_EW, OUTPUT);
  pinMode(ECHO_EW, INPUT);

  pinMode(PED_BUTTON, INPUT_PULLUP);
  pinMode(BUZZER, OUTPUT);

  enterPhase(NS_GO);
}

void loop() {
  distanceNS = readDistance(TRIG_NS, ECHO_NS);
  distanceEW = readDistance(TRIG_EW, ECHO_EW);

  // Detect a pedestrian button press
  bool buttonState = digitalRead(PED_BUTTON);

  if (buttonState == LOW &&
      previousButton == HIGH &&
      millis() - lastButtonChange > 50) {
    pedestrianRequested = true;
    lastButtonChange = millis();

    Serial.println("Pedestrian crossing requested");
  }

  previousButton = buttonState;

  // Change traffic phases when the timer expires
  if (millis() - phaseStart >= phaseDuration) {
    switch (phase) {
      case NS_GO:
        enterPhase(NS_CAUTION);
        break;

      case NS_CAUTION:
        enterPhase(EW_GO);
        break;

      case EW_GO:
        enterPhase(EW_CAUTION);
        break;

      case EW_CAUTION:
        if (pedestrianRequested) {
          enterPhase(PEDESTRIAN);
        } else {
          enterPhase(NS_GO);
        }
        break;

      case PEDESTRIAN:
        enterPhase(NS_GO);
        break;
    }
  }

  // Print sensor readings every second
  static unsigned long lastPrint = 0;

  if (millis() - lastPrint >= 1000) {
    lastPrint = millis();

    Serial.print("North-South distance: ");
    Serial.print(distanceNS);
    Serial.print(" cm | East-West distance: ");
    Serial.print(distanceEW);
    Serial.println(" cm");
  }
}
