/*
  SMART WASTE MANAGEMENT SYSTEM
  Controller: Arduino Uno R3

  Green LED  = Bin has space
  Yellow LED = Bin is partly full
  Red LED    = Bin is nearly full
  Buzzer     = Alerts when bin is nearly full
*/

const int trigPin = 8;
const int echoPin = 9;

const int greenLED = 2;
const int yellowLED = 3;
const int redLED = 4;

const int buzzer = 5;

// Adjust these values to suit your simulated bin.
const int binDepth = 30;       // Distance from sensor to bin bottom (cm)
const int warningLevel = 15;   // Partly full threshold (cm from sensor)
const int fullLevel = 7;       // Nearly full threshold (cm from sensor)

long duration;
float distance;
int fillPercentage;

void setup() {
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  pinMode(greenLED, OUTPUT);
  pinMode(yellowLED, OUTPUT);
  pinMode(redLED, OUTPUT);
  pinMode(buzzer, OUTPUT);

  Serial.begin(9600);

  Serial.println("Smart Waste Management System");
  Serial.println("System starting...");
}

float measureDistance() {
  // Send an ultrasonic pulse.
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  // Read the returning echo.
  duration = pulseIn(echoPin, HIGH, 30000UL);

  // Return -1 if no echo is detected.
  if (duration == 0) {
    return -1;
  }

  return duration * 0.0343 / 2.0;
}

void showStatus(float measuredDistance) {
  // Turn off all outputs before setting the new status.
  digitalWrite(greenLED, LOW);
  digitalWrite(yellowLED, LOW);
  digitalWrite(redLED, LOW);
  noTone(buzzer);

  if (measuredDistance < 0 ||
      measuredDistance > binDepth) {
    Serial.println("No valid reading - check sensor");
    return;
  }

  // A smaller distance means more waste in the bin.
  fillPercentage = (int)(
    ((binDepth - measuredDistance) / binDepth) * 100
  );

  fillPercentage = constrain(fillPercentage, 0, 100);

  Serial.print("Distance: ");
  Serial.print(measuredDistance);
  Serial.print(" cm | Bin fill: ");
  Serial.print(fillPercentage);
  Serial.println("%");

  if (measuredDistance <= fullLevel) {
    // Bin is nearly full.
    digitalWrite(redLED, HIGH);
    tone(buzzer, 1000);

    Serial.println("WARNING: BIN NEARLY FULL!");

  } else if (measuredDistance <= warningLevel) {
    // Bin is partly full.
    digitalWrite(yellowLED, HIGH);

    Serial.println("Bin partly full.");

  } else {
    // Bin has sufficient space.
    digitalWrite(greenLED, HIGH);

    Serial.println("Bin has sufficient space.");
  }
}

void loop() {
  distance = measureDistance();

  showStatus(distance);

  delay(500);
}
